# --------------------------------------------------------------------------- #
#  NOXbot Shop — environment configuration TEMPLATE
#
#  Copy this file to `.env` and fill in the real values:
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
#
#  NEVER put real tokens/passwords in this file — `.env.example` is committed to
#  GitHub, `.env` is git-ignored.
# --------------------------------------------------------------------------- #

# --- Telegram (required) ---
# Bot token issued by @BotFather, format: 1234567890:AA...
BOT_TOKEN=PUT-YOUR-BOT-TOKEN-HERE
# Numeric Telegram user id of the main admin (owner) — get it from @userinfobot.
OWNER_ID=000000000
# Admin panel password — choose a strong one.
ADMIN_PASSWORD=change-me

# --- Database --------------------------------------------------------------- #
# A relative path is fine: it is automatically resolved against the project
# folder (the directory that contains main.py), so the database never moves
# when you launch the bot from a different working directory.
# Windows absolute example: sqlite+aiosqlite:///I:/python/NOXbot/noxbot.db
#   (use forward slashes, or backslashes — both are normalised at startup)
# PostgreSQL example:       postgresql+asyncpg://user:pass@localhost/noxbot
DATABASE_URL=sqlite+aiosqlite:///noxbot.db

# --- Runtime ---------------------------------------------------------------- #
DEFAULT_LANGUAGE=fa
LOG_LEVEL=INFO

# --- Payment (editable from the Admin Panel later) --------------------------- #
CARD_NUMBER=
CARD_HOLDER=
BANK_NAME=

# --- Support / Welcome (editable from the Admin Panel later) ----------------- #
SUPPORT_TEXT=برای پشتیبانی با ادمین تماس بگیرید.
WELCOME_MESSAGE=به فروشگاه گیمینگ NOXbot خوش آمدید!
